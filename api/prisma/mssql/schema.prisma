// Microsoft SQL Server schema. Keep models in sync with ../postgres/schema.prisma —
// only the datasource provider and native column types (@db.*) should differ.
//
// DDL for SQL Server is owned by Prisma Migrate (./migrations). See api/prisma/README.md.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/mssql"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("MSSQL_DATABASE_URL")
  // No foreign keys exist between these tables; Prisma resolves relations itself.
  relationMode = "prisma"
}

/// Customers to contact, per closed store. Y/N flags are CHAR(1) ('Y' | 'N').
model CustomerAssignment {
  customer_name      String   @db.NVarChar(200)
  store_number       String   @db.NVarChar(20)
  phone_number       String?  @db.NVarChar(30)
  contacted_to_store String   @default("N") @db.Char(1)
  attempted_to_store String   @default("N") @db.Char(1)
  do_not_attempt     String?  @default("N") @db.Char(1)
  notes              String?  @db.NVarChar(Max)
  updated_timestamp  DateTime @default(now()) @db.DateTime2

  assignments EmployeeDailyAssignment[]

  @@id([customer_name, store_number])
  @@map("customer_assignment")
}

/// Open store -> closed store mapping.
model StoreAssignment {
  open_store        String   @db.NVarChar(50)
  closed_store      String   @db.NVarChar(50)
  updated_timestamp DateTime @default(now()) @db.DateTime2

  @@unique([open_store, closed_store], map: "uq_store_assignment_pair")
  @@map("store_assignment")
}

model Employee {
  employee_id   String   @id @db.NVarChar(50)
  store_number  String   @db.NVarChar(20)
  employee_name String?  @db.NVarChar(200)
  /// 'Admin' | 'Employee' (case-sensitive)
  role          String   @default("Employee") @db.NVarChar(20)
  created_at    DateTime @default(now()) @db.DateTime2

  @@map("employees")
}

/// Per-employee daily customer claims. The unique constraint is what stops two
/// employees claiming the same customer on the same day.
model EmployeeDailyAssignment {
  id            Int      @id @default(autoincrement())
  employee_id   String   @db.NVarChar(50)
  customer_name String   @db.NVarChar(200)
  store_number  String   @db.NVarChar(20)
  assigned_date DateTime @default(dbgenerated("CAST(SYSUTCDATETIME() AS date)")) @db.Date
  created_at    DateTime @default(now()) @db.DateTime2

  customer CustomerAssignment @relation(fields: [customer_name, store_number], references: [customer_name, store_number], onDelete: Restrict, onUpdate: Restrict)

  @@unique([customer_name, store_number, assigned_date], map: "uq_customer_per_day")
  @@index([employee_id, assigned_date], map: "idx_eda_employee_date")
  @@index([assigned_date, store_number, customer_name], map: "idx_eda_assigned_date")
  @@map("employee_daily_assignments")
}

/// Store location reference, loaded from the store feed CSV.
model StoreDetails {
  rtl_loc_id    String    @id @db.NVarChar(50)
  store_nbr     String    @unique @db.NVarChar(50)
  store_name    String?   @db.NVarChar(100)
  address1      String?   @db.NVarChar(150)
  address2      String?   @db.NVarChar(150)
  address3      String?   @db.NVarChar(150)
  address4      String?   @db.NVarChar(150)
  city          String?   @db.NVarChar(100)
  state         String?   @db.NVarChar(50)
  postal_code   String?   @db.NVarChar(20)
  country       String?   @db.NVarChar(50)
  neighborhood  String?   @db.NVarChar(100)
  county        String?   @db.NVarChar(100)
  telephone1    String?   @db.NVarChar(20)
  store_manager String?   @db.NVarChar(100)
  email_addr    String?   @db.NVarChar(100)
  record_state  String?   @default("ACTIVE") @db.NVarChar(20)
  create_date   DateTime? @default(now()) @db.DateTime2
  update_date   DateTime? @default(now()) @db.DateTime2

  @@map("store_details")
}
