# Postgres connection: either DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=


# Set to "true" to enable SSL with rejectUnauthorized: false.
# Supabase Postgres requires SSL on its direct connection (port 5432) regardless
# of region, so this must be "true" against any Supabase project.
DB_SSL=false

# Origin of the frontend app, for CORS. Must match exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:3000
