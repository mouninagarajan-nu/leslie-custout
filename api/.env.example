# Postgres connection: either DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgresql://postgres.bxbrrhdjrcnwowtyjozw:%5ETN76)_2%2B*)dA-M@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Set to "true" to enable SSL with rejectUnauthorized: false.
DB_SSL=true

# Origin of the frontend app, for CORS. Must match exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:3000

# xCenter SOAP API WSDL URL
# Dev:  https://posapidev.lesl.com/POSApiServices.asmx?WSDL
# Prod: https://posapi.lesl.com/POSApiServices.asmx?WSDL
XCENTER_WSDL_URL=https://posapidev.lesl.com/POSApiServices.asmx?WSDL

# Set to "false" to skip xCenter SOAP calls (useful when working off-VPN locally)
XCENTER_ENABLED=true

# Secret used to sign admin session tokens (store 9999 logins). Optional (has default fallback).
ADMIN_TOKEN_SECRET=

# Virtual store number that marks an employee as an admin. Defaults to 9999.
ADMIN_STORE_NUMBER=9999
