# Which database the API talks to: "postgres" (default) or "mssql".
DB_DIALECT=postgres

# Postgres connection (DB_DIALECT=postgres): either DATABASE_URL, or discrete
# PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE. For Supabase's pooler on port 6543,
# pgbouncer=true is added automatically.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Set to "true" to require SSL (certificate not verified). Supabase URLs imply it.
DB_SSL=true

# SQL Server connection (DB_DIALECT=mssql), in Prisma's sqlserver:// format.
# MSSQL_DATABASE_URL=sqlserver://localhost:1433;database=custout;user=sa;password=[PASSWORD];encrypt=true;trustServerCertificate=true

# Origin of the frontend app, for CORS. Must match exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:3000

# POSAPI SOAP endpoint (used for employee validation and IP-to-store resolution)
# Dev:  https://posapidev.lesl.com/POSApiServices.asmx?WSDL
# Prod: https://posapi.lesl.com/POSApiServices.asmx?WSDL
POSAPI_WSDL_URL=https://posapidev.lesl.com/POSApiServices.asmx?WSDL

# Set to "false" to skip POSAPI SOAP calls (useful when working off-VPN locally).
# When disabled, employees must exist in the local employees table and the store
# is POSAPI_DEFAULT_STORE.
POSAPI_ENABLED=true

# Store to use when POSAPI can't map the client IP to a store. Leave EMPTY in
# production: an unresolved IP then fails login instead of opening another store's
# contacts. Set it (e.g. 5700) only for local dev / off-VPN testing.
POSAPI_DEFAULT_STORE=

# Secret used to sign admin session tokens (store 9999 logins). Optional (has default fallback).
ADMIN_TOKEN_SECRET=

# Virtual store number that marks an employee as an admin. Defaults to 9999.
ADMIN_STORE_NUMBER=9999
